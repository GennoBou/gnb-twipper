{
  "name": "gnb-twipper",
  "version": "1.0.0",
  "description": "Twitch minimalist browser & auto-rotation Chrome Extension (Manifest V3)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "generate-icons": "node scripts/generate-icons.js",
    "build": "npm run generate-icons && vite build",
    "build:firefox": "npm run build && node scripts/build-firefox.js",
    "build-zip": "npm run build && node scripts/package-zip.js",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:bench": "vitest run -c vitest.bench.config.ts",
    "test:all": "npm run test && npm run test:bench"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@lucide/svelte": "^1.30.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.2.0",
    "happy-dom": "^20.14.5",
    "sharp": "^0.35.4",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.5",
    "typescript": "^5.7.0",
    "vite": "^8.2.1",
    "vitest": "^5.0.0"
  }
}
