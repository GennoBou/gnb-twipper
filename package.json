{
  "name": "gnb-twipper",
  "version": "0.1.0",
  "description": "Twitch minimalist browser & auto-rotation Chrome Extension (Manifest V3)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate-icons": "node scripts/generate-icons.js",
    "build": "npm run generate-icons && vite build",
    "build-zip": "npm run build && powershell -Command \"Compress-Archive -Path dist/* -DestinationPath chrome-extension-v0.1.0.zip -Force\"",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@lucide/svelte": "^1.30.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.2.0",
    "sharp": "^0.35.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.5",
    "tslib": "^2.8.1",
    "typescript": "^5.7.0",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@types/acorn": "^4.0.6",
    "acorn": "^8.18.0"
  }
}
