{
  "name": "gnb-twipper",
  "version": "1.0.2",
  "description": "Twitch minimalist browser & auto-rotation Chrome Extension (Manifest V3)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "generate-icons": "node scripts/generate-icons.js",
    "build": "npm run generate-icons && vite build",
    "build:firefox": "npm run build && node scripts/build-firefox.js",
    "build-zip": "npm run build && node scripts/package-zip.js",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:bench": "vitest run -c vitest.bench.config.ts",
    "test:all": "npm run test && npm run test:bench"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@iorate/wepub": "^1.0.6",
    "@lucide/svelte": "^1.74.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "acorn": "^8.19.0",
    "happy-dom": "^21.0.4",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0"
  }
}
